[Unit]
Description=Mana Optical Django (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/mana/backend
EnvironmentFile=/var/www/mana/backend/.env
ExecStart=/var/www/mana/backend/.venv/bin/gunicorn config.wsgi:application \
  --bind 127.0.0.1:8001 \
  --workers 3 \
  --timeout 120
Restart=always

[Install]
WantedBy=multi-user.target
